#!/usr/bin/env python3
"""
tools/pipe/pr-merge — sanctioned merge protocol wrapper + pr_merged v3 span.

Usage: python tools/pipe/pr-merge <pr-number>

Real-path repoint target for reviewer.md's APPROVE-merge action + BEHIND-
retry loop (slice #1078 / PRD #1075 criterion 1): embodies the existing
retry protocol (gh pr update-branch -> poll ci checks -> retry --auto,
bounded 3 attempts total) so the reviewer's inline prose collapses to one
wrapper call. NEVER plain `--squash` — always `--squash --auto --delete-branch`
(preserves the existing reviewer.md merge protocol's branch cleanup).

On a confirmed MERGED state (checked via the REST API — `gh api
repos/<owner>/<repo>/pulls/<n>` — not GraphQL, per the "if gh GraphQL flakes
use REST" guidance), appends one pr_merged span (attrs: pr, sha) with the
elapsed duration. If the PR never reaches MERGED within the attempt bound,
exits non-zero and writes NO span (same atomic-intent contract as pr-open —
no silent half-success).

Env overrides (test seam; production defaults are sane real-world values):
  PR_MERGE_POLL_INTERVAL_S    (default 15) — sleep between `gh pr checks` polls
  PR_MERGE_POLL_TIMEOUT_S     (default 480, ~8 min) — bound on that poll
  PR_MERGE_CONFIRM_INTERVAL_S (default 15) — sleep between merged-confirm polls
  PR_MERGE_CONFIRM_TIMEOUT_S  (default 480, ~8 min) — bound on that poll
"""
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import time

_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
_TOOLS_DIR = os.path.dirname(_THIS_DIR)
_TRACE_PY = os.path.join(_TOOLS_DIR, "trace.py")

MAX_ATTEMPTS = 3
CHECKS_POLL_INTERVAL_S = float(os.environ.get("PR_MERGE_POLL_INTERVAL_S", "15"))
CHECKS_POLL_TIMEOUT_S = float(os.environ.get("PR_MERGE_POLL_TIMEOUT_S", "480"))
CONFIRM_POLL_INTERVAL_S = float(os.environ.get("PR_MERGE_CONFIRM_INTERVAL_S", "15"))
CONFIRM_POLL_TIMEOUT_S = float(os.environ.get("PR_MERGE_CONFIRM_TIMEOUT_S", "480"))


def _load_trace():
    spec = importlib.util.spec_from_file_location("trace_v3", _TRACE_PY)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _gh():
    return shutil.which("gh") or "gh"


def _run_gh(args):
    return subprocess.run([_gh()] + args, capture_output=True, text=True)


def _remote_owner_repo():
    """Resolve owner/repo from `git remote get-url origin` — avoids depending
    on gh's own {owner}/{repo} api templating so this stays stubbable."""
    try:
        url = subprocess.run(
            ["git", "remote", "get-url", "origin"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except Exception:
        return None
    m = re.search(r"[:/]([^/]+)/([^/.]+?)(?:\.git)?$", url)
    if not m:
        return None
    return m.group(1), m.group(2)


def _poll_checks_until_green(pr):
    start = time.monotonic()
    while True:
        res = _run_gh(["pr", "checks", str(pr)])
        combined = ((res.stdout or "") + (res.stderr or "")).lower()
        if res.returncode == 0:
            return True
        if "fail" in combined:
            return False
        if time.monotonic() - start >= CHECKS_POLL_TIMEOUT_S:
            return False
        time.sleep(CHECKS_POLL_INTERVAL_S)


def _confirm_merged(pr):
    """Poll the REST API (not GraphQL) for merged state + merge sha."""
    owner_repo = _remote_owner_repo()
    if not owner_repo:
        return False, None
    owner, repo = owner_repo
    start = time.monotonic()
    while True:
        res = _run_gh(["api", f"repos/{owner}/{repo}/pulls/{pr}"])
        if res.returncode == 0:
            try:
                data = json.loads(res.stdout)
            except json.JSONDecodeError:
                data = {}
            if data.get("merged"):
                return True, data.get("merge_commit_sha")
        if time.monotonic() - start >= CONFIRM_POLL_TIMEOUT_S:
            return False, None
        time.sleep(CONFIRM_POLL_INTERVAL_S)


def main(argv=None):
    argv = list(argv if argv is not None else sys.argv[1:])
    if not argv:
        print("usage: pr-merge <pr-number>", file=sys.stderr)
        return 64
    pr = argv[0]

    start = time.monotonic()
    merged_command_ok = False
    last_returncode = 1
    for attempt in range(1, MAX_ATTEMPTS + 1):
        res = _run_gh(["pr", "merge", pr, "--squash", "--auto", "--delete-branch"])
        sys.stdout.write(res.stdout)
        sys.stderr.write(res.stderr)
        last_returncode = res.returncode
        if res.returncode == 0:
            merged_command_ok = True
            break
        if attempt == MAX_ATTEMPTS:
            print(f"pr-merge: gh pr merge failed after {MAX_ATTEMPTS} attempts; no span written", file=sys.stderr)
            break
        # Recoverable BEHIND-class failure: update branch, wait for green CI, retry.
        _run_gh(["pr", "update-branch", pr])
        _poll_checks_until_green(pr)

    if not merged_command_ok:
        return last_returncode or 1

    merged, sha = _confirm_merged(pr)
    dur_ms = int((time.monotonic() - start) * 1000)
    if not merged:
        print(f"pr-merge: PR #{pr} did not reach confirmed MERGED state; no span written", file=sys.stderr)
        return 1

    trace = _load_trace()
    attrs = {"pr": pr, "sha": sha} if sha else {"pr": pr}
    trace.emit_span(trace_id=f"pr-{pr}", kind="pr_merged", attrs=attrs, dur_ms=dur_ms)
    # attempt is 1-indexed at the successful gh pr merge call; attempts-1 ==
    # the number of update-branch retries the reviewer should report in
    # MERGE_STATUS (behind-retried: <n>).
    print(f"pr-merge: PR #{pr} merged sha={sha} attempts={attempt} behind_retried={attempt - 1}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
