#!/usr/bin/env python3
"""
tools/pipe/qa-verify — atomic wrapper: records a qa-tester production-verify
verdict as a v2 workflow event + a v3 trace span, in the same execution
(PRD #1075 criterion 1 rider, slice #1086).

Usage:
  python tools/pipe/qa-verify --verdict PASS|FAIL|PROVISIONAL --route <route>
      [--pr N] [--prd N] [--slice N] [--proof-source <sid>@<ts>]

Prior to this wrapper, qa-tester's production-verify verdict was reported
only in its own GENERATOR trailer + orchestrator log lines — never durably
recorded (unlike pr_opened/pr_merged, which already had wrapper CLIs).
Repoint target: qa-tester.md's production-verify output-shape section +
ship/SKILL.md's production-verify PASS handling — both call this wrapper
immediately after qa-tester returns its trailer.

Atomic intent: append ONE v2 event ({"event":"production_verify", ...}) to
the canonical workflow-events.jsonl AND ONE v3 span (kind=qa_verified) to the
canonical trace-v3.jsonl, in the same process. If the v2 append fails, the
span is NOT written and this exits non-zero — never a silent half-record.
"""
import argparse
import importlib.util
import json
import os
import subprocess
import sys
from datetime import datetime, timezone

_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
_TOOLS_DIR = os.path.dirname(_THIS_DIR)
_TRACE_PY = os.path.join(_TOOLS_DIR, "trace.py")

VALID_VERDICTS = ("PASS", "FAIL", "PROVISIONAL")


def _load_trace():
    spec = importlib.util.spec_from_file_location("trace_v3", _TRACE_PY)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _git_common_dir_parent():
    out = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    return os.path.dirname(os.path.abspath(out))


def _events_log_path():
    # Mirrors tools/trace.py's own override pattern for test isolation.
    override = os.environ.get("QA_VERIFY_EVENTS_LOG_OVERRIDE")
    if override:
        return override
    return os.path.join(_git_common_dir_parent(), ".claude", "logs", "workflow-events.jsonl")


def main(argv=None):
    parser = argparse.ArgumentParser(prog="qa-verify")
    parser.add_argument("--verdict", required=True, choices=VALID_VERDICTS)
    parser.add_argument("--route", required=True)
    parser.add_argument("--pr", default=None)
    parser.add_argument("--prd", default=None)
    parser.add_argument("--slice", default=None)
    parser.add_argument("--proof-source", default=None)
    args = parser.parse_args(argv)

    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    session_id = os.environ.get("CLAUDE_SESSION_ID", "orchestrator")

    event = {
        "v": 2, "ts": ts, "session_id": session_id, "src": "orchestrator",
        "event": "production_verify", "verdict": args.verdict, "route": args.route,
    }
    if args.pr:
        event["pr"] = args.pr
    if args.prd:
        event["prd"] = args.prd
    if args.slice:
        event["slice"] = args.slice
    if args.proof_source:
        event["proof_source"] = args.proof_source

    log_path = _events_log_path()
    try:
        parent = os.path.dirname(log_path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(log_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(event) + "\n")
    except OSError as e:
        print(f"qa-verify: could not write workflow event ({log_path}): {e}", file=sys.stderr)
        return 2

    trace = _load_trace()
    attrs = {"verdict": args.verdict, "route": args.route}
    for key, val in (("pr", args.pr), ("prd", args.prd), ("slice", args.slice)):
        if val:
            attrs[key] = val
    trace_id = f"qa-{args.pr or args.prd or 'unknown'}"
    trace.emit_span(trace_id=trace_id, kind="qa_verified", attrs=attrs)
    print(f"qa-verify: recorded verdict={args.verdict} route={args.route}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
